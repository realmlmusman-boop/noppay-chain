{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["core/**/*.ts", "wallet/**/*.ts", "consensus/**/*.ts", "network/**/*.ts", "storage/**/*.ts", "node/**/*.ts", "tests/**/*.ts"]
}